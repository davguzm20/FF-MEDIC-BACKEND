generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["ff_medic_db"]
}

enum DocumentType {
  DNI
  PASAPORTE
  CE

  @@schema("ff_medic_db")
}

enum SexType {
  M
  F

  @@schema("ff_medic_db")
}

enum HistoryType {
  PATOLOGICO
  QUIRURGICO

  @@schema("ff_medic_db")
}

enum FamilyType {
  PADRE
  MADRE
  HIJO
  HERMANO
  ABUELO
  TIO
  OTRO

  @@schema("ff_medic_db")
}

enum FamilyStatus {
  VIVO
  FALLECIDO

  @@schema("ff_medic_db")
}

enum ContraceptiveMethod {
  NINGUNO
  AOC
  INYECTABLE
  IMPLANTE
  DIU
  PRESERVATIVO
  LIGADURA
  VASECTOMIA
  OTRO

  @@schema("ff_medic_db")
}

enum OnsetType {
  INSIDIOSO
  BRUSCO

  @@schema("ff_medic_db")
}

enum CourseType {
  PROGRESIVO
  ESTACIONARIO
  INTERMITENTE

  @@schema("ff_medic_db")
}

enum DiagnosisType {
  PRESUNTIVO
  DEFINITIVO
  REPETITIVO

  @@schema("ff_medic_db")
}

enum BioFunctionType {
  SED
  APETITO
  SUEÑO
  ESTADO_ANIMO
  ORINA
  DEPOSICIONES
  VARIACION_PONDERAL

  @@schema("ff_medic_db")
}

enum BioFunctionStatus {
  AUMENTADO
  DISMINUIDO
  CONSERVADO
  NO_EVALUADO

  @@schema("ff_medic_db")
}

enum PhysicalExamSystem {
  ASPECTO_GENERAL
  PIEL_FANERAS
  CABEZA
  CUELLO
  TORAX_PULMONES
  CARDIOVASCULAR
  ABDOMEN
  GENITOURINARIO
  SOMA
  SNC
  OTRO

  @@schema("ff_medic_db")
}

enum ActionType {
  INSERTAR
  ACTUALIZAR
  ELIMINAR

  @@schema("ff_medic_db")
}

enum PhysicalExamStatus {
  CONSERVADO
  OBSERVADO
  DIFERIDO

  @@schema("ff_medic_db")
}

model Patient {
  patientId       Int          @id @default(autoincrement()) @map("patient_id")
  documentType    DocumentType @map("document_type")
  documentNumber  String       @map("document_number") @db.VarChar(20)
  name            String       @map("name") @db.VarChar(100)
  paternalSurname String       @map("paternal_surname") @db.VarChar(50)
  maternalSurname String       @map("maternal_surname") @db.VarChar(50)
  sex             SexType      @map("sex")
  phone           String?      @map("phone") @db.VarChar(15)
  birthDate       DateTime     @map("birth_date") @db.Date
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  clinicalHistories    ClinicalHistory[]
  familyHistories      FamilyHistory[]
  gynecologicalHistory GynecologicalHistory?
  allergyHistories     AllergyHistory[]
  ramHistories         RamHistory[]
  attentions           Attention[]

  @@schema("ff_medic_db")
  @@map("patients")
  @@unique([documentType, documentNumber])
  @@index([documentNumber], name: "idx_patients_document_number")
}

model ClinicalHistory {
  clinicalHistoryId Int         @id @default(autoincrement()) @map("clinical_history_id")
  patientId         Int         @map("patient_id")
  diagnosisId       Int         @map("diagnosis_id")
  type              HistoryType @map("type")
  specifications    String?     @map("specifications") @db.VarChar(200)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  patient  Patient  @relation(fields: [patientId], references: [patientId])
  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [diagnosisId])

  @@schema("ff_medic_db")
  @@map("clinical_histories")
  @@index([patientId], name: "idx_clinical_histories_patient_id")
}

model FamilyHistory {
  familyHistoryId Int          @id @default(autoincrement()) @map("family_history_id")
  patientId       Int          @map("patient_id")
  type            FamilyType   @map("type")
  other           String?      @map("other") @db.VarChar(100)
  status          FamilyStatus @map("status")
  specifications  String?      @map("specifications") @db.VarChar(200)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [patientId])

  @@schema("ff_medic_db")
  @@map("family_histories")
  @@index([patientId], name: "idx_family_histories_patient_id")
}

model GynecologicalHistory {
  gynecologicalHistoryId Int                  @id @default(autoincrement()) @map("gynecological_history_id")
  patientId              Int?                 @unique @map("patient_id")
  menarche               Int?
  menstrualCycle         String?              @map("menstrual_cycle") @db.VarChar(50)
  lastMenstrualPeriod    DateTime?            @map("last_menstrual_period") @db.Date
  contraceptiveMethod    ContraceptiveMethod? @map("contraceptive_method")
  other                  String?              @db.VarChar(100)
  gestations             Int?
  parity                 Int?
  orientation            String?              @db.VarChar(50)
  andria                 Int?
  isa                    DateTime?            @map("isa") @db.Date
  lsa                    DateTime?            @map("lsa") @db.Date
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  patient Patient? @relation(fields: [patientId], references: [patientId])

  @@schema("ff_medic_db")
  @@map("gynecological_histories")
}

model AllergyHistory {
  allergyHistoryId Int      @id @default(autoincrement()) @map("allergy_history_id")
  patientId        Int      @map("patient_id")
  diagnosisId      Int      @map("diagnosis_id")
  specifications   String?  @map("specifications") @db.VarChar(200)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  patient  Patient  @relation(fields: [patientId], references: [patientId])
  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [diagnosisId])

  @@schema("ff_medic_db")
  @@map("allergy_histories")
  @@index([patientId], name: "idx_allergy_histories_patient_id")
}

model RamHistory {
  ramHistoryId       Int      @id @default(autoincrement()) @map("ram_history_id")
  patientId          Int      @map("patient_id")
  activeIngredientId Int      @map("active_ingredient_id")
  diagnosisId        Int      @map("diagnosis_id")
  specifications     String?  @map("specifications") @db.VarChar(200)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  activeIngredient ActiveIngredient @relation(fields: [activeIngredientId], references: [activeIngredientId])
  patient          Patient          @relation(fields: [patientId], references: [patientId])
  diagnosis        Diagnosis        @relation(fields: [diagnosisId], references: [diagnosisId])

  @@schema("ff_medic_db")
  @@map("ram_histories")
  @@index([patientId], name: "idx_ram_histories_patient_id")
}

model Role {
  roleId   Int     @id @default(autoincrement()) @map("role_id")
  name     String  @unique @map("name") @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  users User[]

  @@schema("ff_medic_db")
  @@map("roles")
}

model User {
  userId          Int      @id @default(autoincrement()) @map("user_id")
  roleId          Int      @map("role_id")
  name            String   @map("name") @db.VarChar(100)
  paternalSurname String   @map("paternal_surname") @db.VarChar(50)
  maternalSurname String   @map("maternal_surname") @db.VarChar(50)
  cmpCode         String?  @map("cmp_code") @db.VarChar(10)
  username        String   @unique @map("username") @db.VarChar(50)
  password        String   @map("password") @db.VarChar(250)
  email           String   @unique @map("email") @db.VarChar(254)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [roleId])

  audits Audit[]

  @@schema("ff_medic_db")
  @@map("users")
  @@index([roleId], name: "idx_users_role_id")
}

model ActiveIngredient {
  activeIngredientId Int      @id @default(autoincrement()) @map("active_ingredient_id")
  name               String   @unique @map("name") @db.VarChar(250)
  isActive           Boolean  @default(true) @map("is_active")

  ramHistories       RamHistory[]
  medicaments        MedicamentsIngredient[]

  @@schema("ff_medic_db")
  @@map("active_ingredients")
}

model Manufacturer {
  manufacturerId Int     @id @default(autoincrement()) @map("manufacturer_id")
  name           String @unique @map("name") @db.VarChar(100)
  isActive       Boolean @default(true) @map("is_active")

  medicaments Medicament[]

  @@schema("ff_medic_db")
  @@map("manufacturers")
}

model DosageForm {
  dosageFormId Int     @id @default(autoincrement()) @map("dosage_form_id")
  name         String @unique @map("name") @db.VarChar(100)
  isActive     Boolean @default(true) @map("is_active")

  medicaments Medicament[]

  @@schema("ff_medic_db")
  @@map("dosage_forms")
}

model Medicament {
  medicamentId   Int      @id @default(autoincrement()) @map("medicament_id")
  name           String   @map("name") @db.VarChar(100)
  manufacturerId Int      @map("manufacturer_id")
  concentration  String   @map("concentration") @db.VarChar(50)
  dosageFormId   Int      @map("dosage_form_id")
  isActive       Boolean  @default(true) @map("is_active")

  manufacturer       Manufacturer            @relation(fields: [manufacturerId], references: [manufacturerId])
  dosageForm         DosageForm              @relation(fields: [dosageFormId], references: [dosageFormId])
  activeIngredients  MedicamentsIngredient[]
  prescriptionItems  PrescriptionItem[]

  @@schema("ff_medic_db")
  @@map("medicaments")
  @@unique([name, concentration, manufacturerId, dosageFormId])
  @@index([manufacturerId], name: "idx_medicaments_manufacturer_id")
  @@index([dosageFormId], name: "idx_medicaments_dosage_form_id")
}

model MedicamentsIngredient {
  medicamentId       Int              @map("medicament_id")
  activeIngredientId Int              @map("active_ingredient_id")

  medicament        Medicament        @relation(fields: [medicamentId], references: [medicamentId])
  activeIngredient  ActiveIngredient  @relation(fields: [activeIngredientId], references: [activeIngredientId])

  @@id([medicamentId, activeIngredientId])
  @@schema("ff_medic_db")
  @@map("medicaments_ingredients")
}

model Service {
  serviceId Int     @id @default(autoincrement()) @map("service_id")
  name      String  @unique @map("name") @db.VarChar(100)
  isActive  Boolean @default(true) @map("is_active")

  attentions Attention[]
  referrals    Referral[]

  @@schema("ff_medic_db")
  @@map("services")
}

model Diagnosis {
  diagnosisId Int     @id @default(autoincrement()) @map("diagnosis_id")
  cie10       String  @unique @map("cie_10") @db.VarChar(10)
  description String  @map("description")
  isActive    Boolean @default(true) @map("is_active")

  clinicalHistories  ClinicalHistory[]
  allergyHistories   AllergyHistory[]
  ramHistories       RamHistory[]
  attentionDiagnoses AttentionDiagnosis[]
  signsSymptoms      SignSymptom[]
  referrals          Referral[]

  @@schema("ff_medic_db")
  @@map("diagnoses")
}

model Attention {
  attentionId     Int        @id @default(autoincrement()) @map("attention_id")
  patientId       Int        @map("patient_id")
  serviceId       Int        @map("service_id")
  illnessDuration String     @map("illness_duration") @db.VarChar(50)
  onsetType       OnsetType  @map("onset_type")
  course          CourseType @map("course")
  currentDisease  String     @map("current_disease")
  workPlan        String?    @map("work_plan")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  patient            Patient              @relation(fields: [patientId], references: [patientId])
  service            Service              @relation(fields: [serviceId], references: [serviceId])
  attentionDiagnoses AttentionDiagnosis[]
  signsSymptoms      SignSymptom[]
  healthMetric       HealthMetric?
  bioFunctions       BioFunction[]
  physicalExams      PhysicalExam[]
  exams              Exam[]
  prescriptions      Prescription[]
  referrals          Referral[]

  @@schema("ff_medic_db")
  @@map("attentions")
  @@index([createdAt], name: "idx_attentions_created_at")
  @@index([patientId], name: "idx_attentions_patient_id")
}

model AttentionDiagnosis {
  attentionDiagnosisId Int           @id @default(autoincrement()) @map("attention_diagnosis_id")
  attentionId          Int           @map("attention_id")
  diagnosisId          Int           @map("diagnosis_id")
  type                 DiagnosisType @map("type")
  specifications       String?       @map("specifications") @db.VarChar(200)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  attention Attention @relation(fields: [attentionId], references: [attentionId])
  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [diagnosisId])

  prescriptionDiagnoses PrescriptionDiagnosis[]

  @@unique([attentionId, diagnosisId])
  @@schema("ff_medic_db")
  @@map("attention_diagnoses")
  @@index([attentionId], name: "idx_attention_diagnoses_attention_id")
  @@index([diagnosisId], name: "idx_attention_diagnoses_diagnosis_id")
}

model SignSymptom {
  signSymptomId Int      @id @default(autoincrement()) @map("sign_symptom_id")
  attentionId   Int      @map("attention_id")
  diagnosisId   Int      @map("diagnosis_id")
  observations  String?  @map("observations") @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  attention Attention @relation(fields: [attentionId], references: [attentionId])
  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [diagnosisId])

  @@schema("ff_medic_db")
  @@map("signs_symptoms")
  @@index([attentionId], name: "idx_signs_symptoms_attention_id")
  @@index([diagnosisId], name: "idx_signs_symptoms_diagnosis_id")
}

model HealthMetric {
  healthMetricId     Int      @id @default(autoincrement()) @map("health_metric_id")
  attentionId        Int      @unique @map("attention_id")
  temperature        Decimal? @db.Decimal(4, 2)
  spo2               Int?
  heartRate          Int?     @map("heart_rate")
  respiratoryRate    Int?     @map("respiratory_rate")
  systolicBp         Int?     @map("systolic_bp")
  diastolicBp        Int?     @map("diastolic_bp")
  hgt                Decimal? @db.Decimal(5, 2)
  hemoglobin         Decimal? @db.Decimal(4, 2)
  weight             Decimal? @db.Decimal(5, 2)
  abdominalPerimeter Decimal? @map("abdominal_perimeter") @db.Decimal(5, 2)
  height             Decimal  @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  attention Attention @relation(fields: [attentionId], references: [attentionId])

  @@schema("ff_medic_db")
  @@map("health_metrics")
}

model BioFunction {
  bioFunctionId Int               @id @default(autoincrement()) @map("bio_function_id")
  attentionId   Int               @map("attention_id")
  type          BioFunctionType   @map("type")
  status        BioFunctionStatus @map("status")
  observations  String?           @map("observations") @db.VarChar(200)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  attention Attention @relation(fields: [attentionId], references: [attentionId])

  @@unique([attentionId, type])
  @@schema("ff_medic_db")
  @@map("bio_functions")
  @@index([attentionId], name: "idx_bio_functions_attention_id")
}

model PhysicalExam {
  physicalExamId Int                @id @default(autoincrement()) @map("physical_exam_id")
  attentionId    Int                @map("attention_id")
  system         PhysicalExamSystem @map("system")
  other          String?            @map("other") @db.VarChar(100)
  status         PhysicalExamStatus @map("status")
  observations   String?            @map("observations") @db.VarChar(200)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  attention Attention @relation(fields: [attentionId], references: [attentionId])

  @@unique([attentionId, system])
  @@schema("ff_medic_db")
  @@map("physical_exams")
  @@index([attentionId], name: "idx_physical_exams_attention_id")
}

model Procedure {
  procedureId Int     @id @default(autoincrement()) @map("procedure_id")
  type        String  @map("type") @db.VarChar(50)
  category    String? @map("category") @db.VarChar(100)
  description String  @map("description") @db.VarChar(200)
  isActive    Boolean @default(true) @map("is_active")

  examItems ExamItem[]

  @@unique([type, category, description])
  @@schema("ff_medic_db")
  @@map("procedures")
}

model Exam {
  examId      Int      @id @default(autoincrement()) @map("exam_id")
  attentionId Int      @map("attention_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attention Attention  @relation(fields: [attentionId], references: [attentionId])
  examItems ExamItem[]

  @@schema("ff_medic_db")
  @@map("exams")
  @@index([attentionId], name: "idx_exams_attention_id")
}

model ExamItem {
  examItemId  Int       @id @default(autoincrement()) @map("exam_item_id")
  examId      Int       @map("exam_id")
  procedureId Int       @map("procedure_id")
  indications String?   @map("indications") @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at")

  exam      Exam      @relation(fields: [examId], references: [examId])
  procedure Procedure @relation(fields: [procedureId], references: [procedureId])

  @@schema("ff_medic_db")
  @@map("exam_items")
  @@index([examId], name: "idx_exam_items_exam_id")
  @@index([procedureId], name: "idx_exam_items_procedure_id")
}

model Prescription {
  prescriptionId Int      @id @default(autoincrement()) @map("prescription_id")
  attentionId    Int      @map("attention_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  attention         Attention          @relation(fields: [attentionId], references: [attentionId])
  prescriptionItems PrescriptionItem[]

  @@schema("ff_medic_db")
  @@map("prescriptions")
  @@index([attentionId], name: "idx_prescriptions_attention_id")
}

model PrescriptionItem {
  prescriptionItemId Int      @id @default(autoincrement()) @map("prescription_item_id")
  prescriptionId     Int      @map("prescription_id")
  medicamentId       Int      @map("medicament_id")
  quantity           Int      @map("quantity")
  indications        String?  @map("indications") @db.VarChar(200)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  prescription          Prescription            @relation(fields: [prescriptionId], references: [prescriptionId])
  medicament            Medicament              @relation(fields: [medicamentId], references: [medicamentId])
  prescriptionDiagnoses PrescriptionDiagnosis[]

  @@schema("ff_medic_db")
  @@map("prescription_items")
  @@index([prescriptionId], name: "idx_prescription_items_prescription_id")
}

model PrescriptionDiagnosis {
  prescriptionItemId   Int @map("prescription_item_id")
  attentionDiagnosisId Int @map("attention_diagnosis_id")

  prescriptionItem  PrescriptionItem   @relation(fields: [prescriptionItemId], references: [prescriptionItemId])
  attentionDiagnosis AttentionDiagnosis @relation(fields: [attentionDiagnosisId], references: [attentionDiagnosisId])

  @@id([prescriptionItemId, attentionDiagnosisId])
  @@schema("ff_medic_db")
  @@map("prescription_diagnoses")
}

model Referral {
  referralId  Int      @id @default(autoincrement()) @map("referral_id")
  attentionId Int      @map("attention_id")
  serviceId   Int      @map("service_id")
  diagnosisId Int?     @map("diagnosis_id")
  reason      String?  @map("reason") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attention Attention  @relation(fields: [attentionId], references: [attentionId])
  service   Service    @relation(fields: [serviceId], references: [serviceId])
  diagnosis Diagnosis? @relation(fields: [diagnosisId], references: [diagnosisId])

  @@schema("ff_medic_db")
  @@map("referrals")
  @@index([attentionId], name: "idx_referrals_attention_id")
  @@index([serviceId], name: "idx_referrals_service_id")
  @@index([diagnosisId], name: "idx_referrals_diagnosis_id")
}

model Audit {
  auditId   Int        @id @default(autoincrement()) @map("audit_id")
  tableName String     @map("table_name") @db.VarChar(50)
  recordId  Int        @map("record_id")
  action    ActionType @map("action")
  userId    Int?       @map("user_id")
  oldData   Json?      @map("old_data")
  newData   Json?      @map("new_data")
  ip        String?    @map("ip") @db.VarChar(45)
  userAgent String?    @map("user_agent") @db.VarChar(250)
  createdAt DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [userId])

  @@schema("ff_medic_db")
  @@map("audits")
}
